# zkopíruj do backend/.env a uprav

# claude_code = `claude -p` přes předplatné Pro/Max | claude_api = API klíč
LLM_BACKEND=claude_code
# jen pro claude_api (+ pip install anthropic):
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-5-5

# n8n běží v Dockeru, backend na hostiteli
N8N_URL=http://localhost:5678
# volitelné: uložit každý výsledek přes n8n workflow /publish
# N8N_PUBLISH_URL=http://localhost:5678/webhook/publish

# n8n | searxng (hledat přímo v SearXNG, když ještě nemáš n8n workflow)
SEARCH_BACKEND=n8n
SEARXNG_URL=http://localhost:8888

# kolikrát se smí evaluator vrátit do planneru
MAX_ITERATIONS=2
