            }
          ]
        }
      },
      "id": "dc39773c-b918-51ac-80f2-a226c0da3a3f",
      "name": "Každý den 8:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
