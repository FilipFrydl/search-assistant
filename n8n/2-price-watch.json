        "jsCode": "const data = $getWorkflowStaticData('global');\nreturn (data.watches || []).map(w => ({ json: w }));\n"
      },
      "id": "d32ba371-5a76-55e2-8cc3-92e0e74eb728",
      "name": "Sledované položky",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        500
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0 (research-assistant price watch)"
            }
          ]
        },
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "html"
            }
          }
        }
      },
      "id": "1f06053d-6895-5549-9233-d68563b87802",
      "name": "Stáhnout stránku",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        500
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// '2 790 Kč', '2.790,-', '2790 CZK' -> 2790\nconst priceRe = /(\\d{1,3}(?:[  .]\\d{3})+|\\d{3,6})(?:,\\d{1,2}|,-)?\\s*(?:Kč|CZK|,-)/i;\nconst parsePrice = (text) => {\n  const m = String(text || '').match(priceRe);\n  return m ? Number(m[1].replace(/[\\s.]/g, '')) : null;\n};\n\n// cena ze stránky produktu: JSON-LD / meta tagy, jinak první \"xxx Kč\"\nconst extractPrice = (html) => {\n  const patterns = [\n    /\"price\"\\s*:\\s*\"?(\\d+(?:[.,]\\d+)?)\"?/i,\n    /itemprop=[\"']price[\"'][^>]*content=[\"'](\\d+(?:[.,]\\d+)?)/i,\n    /property=[\"']product:price:amount[\"'][^>]*content=[\"'](\\d+(?:[.,]\\d+)?)/i,\n  ];\n  for (const re of patterns) {\n    const m = html.match(re);\n    if (m) return Number(m[1].replace(',', '.'));\n  }\n  return parsePrice(html.replace(/<[^>]+>/g, ' '));\n};\n\nconst data = $getWorkflowStaticData('global');\nconst watches = $('Sledované položky').all().map(i => i.json);\nconst now = new Date().toISOString();\n\nreturn $input.all().map((item, i) => {\n  const w = watches[i];\n  const price = extractPrice(String(item.json.html || ''));\n  const previous = w.last_price;\n  const belowTarget = price && w.target_price && price <= w.target_price && !w.notified_target;\n  const dropped = Boolean(price && ((previous && price < previous) || belowTarget));\n\n  const stored = (data.watches || []).find(x => x.url === w.url);\n  if (stored && price) {\n    stored.last_price = price;\n    stored.checked = now;\n    if (belowTarget) stored.notified_target = true;\n  }\n  return { json: { ...w, price, previous, dropped } };\n});\n"
      },
      "id": "d34fdab2-dfa0-5f0a-bc3d-a237a410345b",
      "name": "Zjistit cenu",
