{
  "name": "Research – hlídání ceny",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "watch",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "921865bd-0ad2-5926-961c-1a26574a0062",
      "name": "Webhook /watch",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        100
      ],
      "webhookId": "646515a3-78b0-5693-9dd1-295b2590774c"
    },
    {
      "parameters": {
        "jsCode": "// sledované položky drží workflow static data (ukládá se jen u aktivního workflow)\nconst data = $getWorkflowStaticData('global');\ndata.watches = data.watches || [];\nconst w = $input.first().json.body || {};\nif (!w.url) return [{ json: { ok: false, error: 'chybí url' } }];\n\nconst entry = {\n  model: w.model || w.url,\n  url: w.url,\n  shop: w.shop || '',\n  currency: w.currency || 'CZK',\n  last_price: Number(w.price) || null,\n  target_price: Number(w.target_price) || null,  // null = hlídat jakýkoli pokles\n  notified_target: false,\n  created: new Date().toISOString(),\n};\nconst existing = data.watches.find(x => x.url === entry.url);\nif (existing) Object.assign(existing, entry); else data.watches.push(entry);\nreturn [{ json: { ok: true, count: data.watches.length, watch: entry } }];\n"
      },
      "id": "f62c5666-6d3a-5bc4-b2de-441d5725d37c",
      "name": "Uložit sledování",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        100
      ]
    },
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "watches",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "eef7daae-c011-5b9d-a0f4-602bf83ca807",
      "name": "Webhook GET /watches",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "00a3a23d-9628-5ff1-afdc-69085e8e3e6e"
    },
    {
      "parameters": {
        "jsCode": "const data = $getWorkflowStaticData('global');\nreturn [{ json: { watches: data.watches || [] } }];\n"
      },
      "id": "07fc3a2c-79dc-540b-b38e-d8fc381e0546",
      "name": "Vypsat sledování",
