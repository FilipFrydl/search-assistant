      "parameters": {
        "jsCode": "// webhook dostane { queries: [...], size, max_price, currency } -> jeden item na dotaz\nconst body = $input.first().json.body || {};\nconst queries = (body.queries || []).filter(Boolean);\nif (!queries.length) return [{ json: { q: '' } }];\nreturn queries.map(q => ({ json: { q } }));\n"
