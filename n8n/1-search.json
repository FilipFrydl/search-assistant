    {
      "parameters": {},
      "id": "27fde2ae-5b13-5b8c-8918-d7008b3459f7",
      "name": "Merge",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// '2 790 Kč', '2.790,-', '2790 CZK' -> 2790\nconst priceRe = /(\\d{1,3}(?:[  .]\\d{3})+|\\d{3,6})(?:,\\d{1,2}|,-)?\\s*(?:Kč|CZK|,-)/i;\nconst parsePrice = (text) => {\n  const m = String(text || '').match(priceRe);\n  return m ? Number(m[1].replace(/[\\s.]/g, '')) : null;\n};\n\nconst body = $('Webhook /search').first().json.body || {};\nconst maxPrice = Number(body.max_price) || null;\nconst seen = new Set();\nconst offers = [];\n\nfor (const item of $input.all()) {\n  for (const r of (item.json.results || []).slice(0, 10)) {\n    if (!r.url || seen.has(r.url)) continue;\n    seen.add(r.url);\n    const price = parsePrice(`${r.title || ''} ${r.content || ''}`);\n    if (price && maxPrice && price > maxPrice) continue;  // nad rozpočet\n    let shop = '';\n    try { shop = new URL(r.url).hostname.replace(/^www\\./, ''); } catch (e) {}\n    offers.push({\n      title: r.title || '',\n      url: r.url,\n      snippet: r.content || '',\n      price,\n      currency: price ? 'CZK' : null,\n      shop,\n      size_available: null,  // z výsledků vyhledávače se nedá zjistit\n      source: r.engine || 'searxng',\n    });\n  }\n}\n// nabídky s cenou napřed\noffers.sort((a, b) => (a.price === null) - (b.price === null));\nreturn [{ json: { offers } }];\n"
      },
